# Nightshift Assistant — environment configuration.
# Copy to .env on the host (never commit .env). This file documents EVERY env
# var the code reads; the code reads nothing undocumented.

# ── Kill-switch ──────────────────────────────────────────────────────────────
# The daemon REFUSES to start unless this is exactly "true". Default OFF —
# the spine ships dark until the operator flips it on the host.
NIGHTSHIFT_ENABLED=false

# ── Webex (all three required; startup fails fast if any is missing) ─────────
# Bot access token from developer.webex.com (the NEW parallel-run bot identity,
# not the old NSAF bot's).
WEBEX_BOT_TOKEN=
# HMAC-SHA1 secret set when registering the webhook. When unset the daemon
# rejects ALL webhook deliveries (fail closed).
WEBEX_WEBHOOK_SECRET=
# Your Webex personId — the only sender the assistant will answer.
WEBEX_OWNER_PERSON_ID=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# Webex API base URL. Override only in tests (points at a local fixture server).
#WEBEX_API_BASE=https://webexapis.com/v1
# Path to the claude binary for the conversational session (test seam).
#NIGHTSHIFT_AGENT_BIN=claude
# SQLite database file (created on first start; parent dir auto-created).
#NIGHTSHIFT_DB_PATH=data/nightshift.db
# HTTP port. The daemon ALWAYS binds 127.0.0.1 — only the cloudflared tunnel
# exposes /webhook; the bind address is not configurable.
#NIGHTSHIFT_PORT=3777
# Seconds before an in-flight agent turn is killed and reported as an error.
#NIGHTSHIFT_TURN_TIMEOUT_SEC=300

# ── Backup script only (scripts/backup.sh, set by nightshift-backup.service) ─
# Destination directory for VACUUM INTO backups (outside the primary data dir).
#NIGHTSHIFT_BACKUP_DIR=~/backups/nightshift
# How many newest backups to keep.
#NIGHTSHIFT_BACKUP_KEEP=14
