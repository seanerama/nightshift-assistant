# Nightshift Assistant — environment configuration.
# Copy to .env on the host (never commit .env). This file documents EVERY env
# var the code reads; the code reads nothing undocumented.

# ── Kill-switch ──────────────────────────────────────────────────────────────
# The daemon REFUSES to start unless this is exactly "true". Default OFF —
# the spine ships dark until the operator flips it on the host.
NIGHTSHIFT_ENABLED=false

# ── Webex (all three required; startup fails fast if any is missing) ─────────
# Bot access token from developer.webex.com (the NEW parallel-run bot identity,
# not the old NSAF bot's).
WEBEX_BOT_TOKEN=
# HMAC-SHA1 secret set when registering the webhook. When unset the daemon
# rejects ALL webhook deliveries (fail closed).
WEBEX_WEBHOOK_SECRET=
# Your Webex personId — the only sender the assistant will answer.
WEBEX_OWNER_PERSON_ID=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# Webex API base URL. Override only in tests (points at a local fixture server).
#WEBEX_API_BASE=https://webexapis.com/v1
# Path to the claude binary for the conversational session (test seam).
#NIGHTSHIFT_AGENT_BIN=claude
# Conversational model (Stage 12): passed as --model on EVERY conversational
# spawn — explicit, never inherited from the host claude config. Applies
# regardless of NIGHTSHIFT_CONTROL_ENABLED (runtime config, not a feature).
# Must be a non-empty model id when set (whitespace fails fast). Workers use
# per-type models from the job-type registry instead (story/study/brief/
# app-build → claude-opus-4-8; generic → claude-sonnet-5; not env-configurable).
#NIGHTSHIFT_MODEL=claude-sonnet-5
# SQLite database file (created on first start; parent dir auto-created).
#NIGHTSHIFT_DB_PATH=data/nightshift.db
# HTTP port. The daemon ALWAYS binds 127.0.0.1 — only the cloudflared tunnel
# exposes /webhook; the bind address is not configurable.
#NIGHTSHIFT_PORT=3777
# Seconds before an in-flight agent turn is killed and reported as an error.
#NIGHTSHIFT_TURN_TIMEOUT_SEC=300
# Slow-turn receipt (Stage 8): when a reply takes longer than this many
# seconds, the bot sends ONE short "working on it" ack so a slow turn is
# distinguishable from a dead bot. 0 disables the ack entirely (the only
# knob — the feature is inert when disabled). Default 5.
#NIGHTSHIFT_ACK_AFTER_SEC=5

# ── Session rotation (Stage 2; ships dark) ───────────────────────────────────
# Master switch for the rotation triggers (daily + size-cap) AND new-session
# seeding. Unless this is exactly "true", relay behaves exactly as Stage 1.
# Any value other than "true"/"false"/unset refuses to start (fail fast).
#NIGHTSHIFT_ROTATION_ENABLED=false
# Local hour (0-23) after which the daily rotation fires. A session started
# before the most recent boundary rotates at the next in-daemon check (every
# 60s); boundaries missed while the daemon was down rotate on the next check.
#NIGHTSHIFT_ROTATE_HOUR=4
# Size-cap safety valve: when a relay turn pushes the session's turn count past
# this, the session rotates right after that turn completes.
#NIGHTSHIFT_SIZE_CAP_TURNS=200
# Max bytes of seed context (memory/ files + latest logs/daily/ summary) handed
# to a brand-new session; oldest content is dropped first (newest wins).
#NIGHTSHIFT_SEED_MAX_BYTES=16384

# ── Job runner (Stage 4; ships dark) ─────────────────────────────────────────
# Master switch for background worker jobs. Unless this is exactly "true",
# submit() rejects and no reconciler/poller runs. Any value other than
# "true"/"false"/unset refuses to start (fail fast). Workers always run with
# the default-deny allow-list env — WEBEX_* and other infra credentials never
# reach a worker (FIX-H3).
#NIGHTSHIFT_JOBS_ENABLED=false
# Max concurrently LIVE worker processes (the reconciler counts live pids,
# never raw row counts); further submissions queue and start as slots free up.
#NIGHTSHIFT_MAX_JOBS=2
# Attempts bound: a job that has failed this many times lands terminal `failed`
# (below the cap, a failure re-queues a fresh linked attempt automatically).
#NIGHTSHIFT_JOB_RETRY_CAP=2
# Seconds between kill()'s SIGTERM and the SIGKILL follow-up.
#NIGHTSHIFT_JOB_KILL_GRACE_SEC=10
# Default per-job wall-clock timeout (ms): a running worker whose persisted start
# time is older than this is killed by the reconciler (SIGTERM→SIGKILL) and
# recorded terminally as timed out — turning a worker whose model call stalls
# (which would otherwise hang forever) into a clean, notified failure. Restart-
# safe (keyed off the persisted start time, not an in-memory timer). Generous by
# default (2h = 7200000) so long content/app-build pipelines are never cut short;
# tighter per-type overrides (e.g. note-ingest = 15m) live in the job-type
# registry. Positive integer; anything else refuses to start (fail fast).
#NIGHTSHIFT_JOB_TIMEOUT_MS=7200000

# ── Control API + nightshift CLI (Stage 5; ships dark) ──────────────────────
# Master switch for the control surface: the loopback /api/v1/ endpoints, the
# bin/nightshift CLI, and the conversational session's Bash(nightshift *) tool
# access + capability preamble. Unless this is exactly "true", every /api/v1/
# request returns 403 and session spawns are byte-identical to Stage 4. Any
# value other than "true"/"false"/unset refuses to start (fail fast).
#NIGHTSHIFT_CONTROL_ENABLED=false
# Per-install bearer token REQUIRED on every /api/v1/ request (fail closed:
# unset/empty → all requests 401). Defense in depth: workers never receive it
# (default-deny env), so they cannot drive the daemon even on loopback; only
# the conversational session's spawn env carries it. REQUIRED non-empty when
# NIGHTSHIFT_CONTROL_ENABLED=true — startup fails fast otherwise. Generate at
# deploy time, e.g.:  openssl rand -hex 32
#NIGHTSHIFT_API_TOKEN=

# ── Job-type registry (Stage 6; ships dark) ─────────────────────────────────
# Master switch for typed job submits (story/study/brief/app-build). Unless
# this is exactly "true", any non-generic `nightshift submit --type <t>
# --params ...` (and the API's { type, params } body) rejects with a clear
# error, workers spawn exactly as Stage 5, and the session preamble omits the
# type list. Generic jobs are unaffected. Any value other than
# "true"/"false"/unset refuses to start (fail fast).
#NIGHTSHIFT_TYPES_ENABLED=false
#
# Per-type extra worker env (NAME-EXPLICIT, Stage 6): when a typed worker
# spawns, the runner copies ONLY the var names the registry declares for that
# type from the daemon's env (this file) on top of the default-deny worker
# allow-list — nothing else, and never WEBEX_*/NIGHTSHIFT_* (blocked by prefix
# regardless of what a registry entry lists). Set the ones the pipelines you
# use need; absent vars are simply not forwarded.
#   story:  ELEVENLABS_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY,
#           GOOGLE_API_KEY, NANOBANANA_API_KEY
#   study:  PERPLEXITY_API_KEY
#   brief:  PERPLEXITY_API_KEY
#   app-build, generic: (none)
#ELEVENLABS_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
#NANOBANANA_API_KEY=
#PERPLEXITY_API_KEY=

# ── Delivery + attachments (Stage 10) ───────────────────────────────────────
# Per-file attachment cap in MB for Webex sends — both `nightshift deliver`
# (POST /api/v1/deliver) and auto-attached success outputs. Webex's own cap is
# ~100MB; files over THIS cap are rejected with a clear error before anything
# is sent. 0 disables file attachments entirely.
#NIGHTSHIFT_ATTACH_MAX_MB=80
# Auto-attach cap in MB: success-notice sentinel outputs that exist, are
# regular files, and are at or under this size ride the finish notice (first 3
# at most; anything larger — videos — stays on-request via `nightshift
# deliver`). Auto-attach also requires NIGHTSHIFT_CONTROL_ENABLED=true (same
# switch as on-request delivery). 0 disables auto-attach.
#NIGHTSHIFT_AUTOATTACH_MAX_MB=10

# ── Content promotion (Stages 11 + 13; ships dark) ──────────────────────────
# Master switch for content promotion (contracts/promotion.md +
# contracts/site-promotion.md): the POST /api/v1/promote endpoint, the
# `nightshift promote` CLI, and the session's promote preamble line. Unless
# this is exactly "true", both faces refuse. Any value other than
# "true"/"false"/unset refuses to start (fail fast). When it IS "true", ALL
# TEN infra vars below AND NIGHTSHIFT_WEBSITE_REPO must be set (non-empty)
# or startup fails fast.
#NIGHTSHIFT_PROMOTE_ENABLED=false
#
# Website pipeline (Stage 13, contracts/site-promotion.md) — study content
# deploys INTO the Astro website at https://www.<NSAF_DOMAIN>/study-guides/
# <slug> (staged, built, pushed; hosting auto-deploys on push).
# Local clone of the Astro website repo. REQUIRED when promotion is enabled;
# must already exist and be a git clone (startup fails fast otherwise). The
# host value mirrors the old NSAF_WEBSITE_REPO.
#NIGHTSHIFT_WEBSITE_REPO=
# bun binary used for the website verify-build (default "bun"; the host value
# mirrors the old BUN_PATH). Tests point this at a stub — never a real bun
# build in CI.
#NIGHTSHIFT_BUN_PATH=bun
#
# The ten infra env names the promotion pipeline consumes — DAEMON-ONLY by
# construction: workerEnv() hard-blocks the CF_ and COOLIFY_ prefixes, so no
# worker session can ever receive them (ADR 0008). Values live on the host
# only; never commit them. The repo step additionally shells out to the
# host's `git` + `gh` (authenticated as the daemon user).
# Coolify: API base URL (no /api/v1 suffix), API token, and the existing
# project/server/environment promotions deploy into.
#COOLIFY_API_URL=
#COOLIFY_API_TOKEN=
#COOLIFY_PROJECT_UUID=
#COOLIFY_SERVER_UUID=
#COOLIFY_ENVIRONMENT=
# Cloudflare: account/zone/tunnel ids + the API token used for BOTH the tunnel
# ingress route and the DNS CNAME.
#CF_ACCOUNT_ID=
#CF_ZONE_ID=
#CF_TUNNEL_ID=
#CF_DNS_TOKEN=
# The public apex domain — app promotions go live at https://<slug>.
# <NSAF_DOMAIN>; study promotions at https://www.<NSAF_DOMAIN>/study-guides/
# <slug>.
#NSAF_DOMAIN=
#
# Promotion test seams (override only in tests, like WEBEX_API_BASE):
# Cloudflare API base URL (tests point it at a local fixture server).
#CF_API_BASE=https://api.cloudflare.com/client/v4
# Health-check base: when set, the final health step GETs <base>/<slug>
# (subdomain pipeline) or <base>/study-guides/<slug> (website pipeline)
# instead of the real https URL. Leave unset in production.
#NIGHTSHIFT_PROMOTE_HEALTH_BASE=

# ── reMarkable PUSH (Stage 19; ships dark) ──────────────────────────────────
# Master switch for the "assistant → tablet" bridge: the POST /api/v1/remarkable
# endpoint, the `nightshift remarkable <path>` CLI, and the session's remarkable
# preamble line. `nightshift remarkable <path>` uploads a document to the owner's
# reMarkable tablet — it lands in the folder below via the reMarkable CLOUD API
# and syncs down on the tablet's next sync (works with the tablet off-network).
# Unless this is exactly "true", the capability refuses (no reachable route, no
# preamble). Any value other than "true"/"false"/unset refuses to start (fail
# fast).
#NIGHTSHIFT_REMARKABLE_ENABLED=false
# Destination folder on the tablet for pushed docs (default /Inbox).
#NIGHTSHIFT_REMARKABLE_FOLDER=/Inbox
# Path to the rmapi binary on the host (default "rmapi", resolved on the daemon's
# PATH). rmapi + its config (~/.config/rmapi/rmapi.conf, which holds the
# reMarkable DEVICE TOKEN) are a DAEMON-ONLY host secret provisioned at deploy —
# never committed, never placed in any worker env. This var is just the binary
# path; tests point it at a stub, never a real rmapi.
#RMAPI_BIN=rmapi

# ── Backup script only (scripts/backup.sh, set by nightshift-backup.service) ─
# Destination directory for VACUUM INTO backups (outside the primary data dir).
#NIGHTSHIFT_BACKUP_DIR=~/backups/nightshift
# How many newest backups to keep.
#NIGHTSHIFT_BACKUP_KEEP=14
