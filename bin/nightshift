#!/usr/bin/env node
/**
 * nightshift — the 1:1 human/agent face of the control API
 * (contracts/control-api.md, frozen v1). Zero dependencies: global fetch
 * against http://127.0.0.1:<port>/api/v1/. The conversational session invokes
 * its tools ONLY through this CLI; the operator runs the same commands over SSH.
 *
 * Auth/port: NIGHTSHIFT_API_TOKEN + NIGHTSHIFT_PORT from the environment,
 * falling back to the app dir's .env (the dir above this script's real path —
 * symlinks resolved, so ~/.local/bin/nightshift finds the deploy's .env).
 * Workers never have the token (default-deny env), so they cannot use this.
 *
 * Exit codes (contract): 0 on ok:true, 1 otherwise. --json prints the raw API
 * JSON body. No top-level import/require: the script stays runnable whether
 * Node classifies it as ESM (in-repo, package.json type:module) or CommonJS
 * (copied elsewhere) — dynamic import() is legal in both.
 */
'use strict';

const USAGE = `nightshift — control the Nightshift Assistant daemon (loopback API)

Usage:
  nightshift submit --type <type> --title <title> --instruction <text> --workdir <dir>
                                   Submit a raw background job (generic worker)
  nightshift submit --type <type> --params '<json>'
                                   Submit a typed job (e.g. story|study|brief|app-build);
                                   the daemon renders instruction/workdir/permissions
                                   from its job-type registry
  nightshift jobs [--status <s>]   List jobs (status: queued|running|succeeded|failed|killed)
  nightshift job <id>              Show one job
  nightshift kill <id>             Kill a job (SIGTERM, then SIGKILL)
  nightshift deliver <path> [--note <text>]
                                   Send a file to the owner's Webex room as an
                                   attachment (allowed roots: ~/projects and the
                                   app's jobs/ + logs/ dirs)
  nightshift promote <path> [--slug <s>] [--title <t>] [--dry-run|--yes]
                                   Promote a content dir (~/projects). STUDY
                                   content deploys into the Astro website at
                                   https://www.<domain>/study-guides/<slug>
                                   (staged + built + pushed; hosting
                                   auto-deploys); story promotion is not yet
                                   designed (rejected). DRY RUN IS THE DEFAULT
                                   — the plan is printed and nothing executes;
                                   pass --yes to execute (runs in the
                                   background, result arrives as a 🚀 notice
                                   in Webex)
  nightshift remarkable <path>     Push a document to the owner's reMarkable
                                   tablet /Inbox via the reMarkable cloud (it
                                   syncs to the tablet on its next sync; allowed
                                   roots: ~/projects and the app's jobs/ + logs/
                                   dirs)
  nightshift ui validate <file|->  Dry-run the generative-UI validator on a
                                   single-file HTML page (nothing written; exit
                                   0 only when the page is valid). "-" reads
                                   the HTML from stdin to EOF (pipe or
                                   heredoc); "-" ALWAYS means stdin, never a
                                   file named "-"
  nightshift ui install <file|-> --name <n> [--tools a,b] [--provenance <text>]
                                   Validate + register the page as the NEXT
                                   version of ui://nightshift/<n> (v1 for a
                                   new name), made active; prior versions are
                                   retained for rollback. --tools names MCP
                                   tools the page requests (grants are
                                   separate; the served allowlist stays empty
                                   until granted). "-" reads the HTML from
                                   stdin, exactly as on ui validate
  nightshift ui list               List registered UI resources (active
                                   version per name)
  nightshift ui show <name> [<version>]
                                   Without a version: every version of the
                                   name (active marked). With one: that
                                   version's record (--json includes the html)
  nightshift ui activate <name> <version>
                                   Make an already-registered version the
                                   active one (rollback = re-activation;
                                   nothing is deleted)
  nightshift ui grant <name> <tool> --approval <text>
                                   Grant an MCP tool to a registered UI
                                   resource — a durable owner-approval record
                                   (--approval is the owner's in-chat approval
                                   message). The served allowlist is
                                   granted ∩ requested per version
  nightshift ui revoke <name> <tool>
                                   Revoke a granted tool — immediate across
                                   all versions of the name; the grant row is
                                   kept (revoked, never deleted)
  nightshift ui state <name>       Read the resource's persisted state
                                   document (per-name JSON; value and
                                   updatedAt are null before the first set;
                                   --json for the raw body)
  nightshift ui state <name> --set '<json>'
                                   Replace the WHOLE state document with the
                                   given JSON (any JSON value, serialized
                                   <= 64 KB; full replace, last-write-wins)
  nightshift rotate                Rotate the conversational session (manual)
  nightshift status                Daemon status (version, uptime, session, job counts)

Options:
  --json                           Print the raw API JSON response
  -h, --help                       Show this help

Environment:
  NIGHTSHIFT_API_TOKEN             Bearer token for the API (required)
  NIGHTSHIFT_PORT                  Daemon port (default 3777)
  Both fall back to the app directory's .env when unset.

Exit codes: 0 when the API replies ok:true; 1 on any error.`;

/** Print an error and exit 1 — the single failure path. */
function fail(message) {
  process.stderr.write(`error: ${message}\n`);
  process.exit(1);
}

/** Minimal .env parser: KEY=value lines, # comments, optional single/double quotes. */
function parseEnvFile(text) {
  const out = {};
  for (const rawLine of text.split('\n')) {
    const line = rawLine.trim();
    if (line === '' || line.startsWith('#')) continue;
    const eq = line.indexOf('=');
    if (eq <= 0) continue;
    const key = line.slice(0, eq).trim();
    let value = line.slice(eq + 1).trim();
    if (
      (value.startsWith('"') && value.endsWith('"') && value.length >= 2) ||
      (value.startsWith("'") && value.endsWith("'") && value.length >= 2)
    ) {
      value = value.slice(1, -1);
    }
    out[key] = value;
  }
  return out;
}

/** Token + port from env, then the app dir's .env (script realpath's parent dir). */
async function resolveConnection() {
  let token = process.env.NIGHTSHIFT_API_TOKEN;
  let port = process.env.NIGHTSHIFT_PORT;
  let envPath = '<app dir>/.env';
  if (token === undefined || token === '' || port === undefined || port === '') {
    const fs = await import('node:fs');
    const path = await import('node:path');
    try {
      const script = fs.realpathSync(process.argv[1]);
      envPath = path.join(path.dirname(path.dirname(script)), '.env');
      const fileEnv = parseEnvFile(fs.readFileSync(envPath, 'utf8'));
      if (token === undefined || token === '') token = fileEnv.NIGHTSHIFT_API_TOKEN;
      if (port === undefined || port === '') port = fileEnv.NIGHTSHIFT_PORT;
    } catch {
      // No .env — the explicit checks below report what is missing.
    }
  }
  if (token === undefined || token === '') {
    fail(`NIGHTSHIFT_API_TOKEN is not set (checked the environment and ${envPath})`);
  }
  return { token, port: port === undefined || port === '' ? '3777' : port };
}

/** One API round-trip. Network/parse failures exit 1 here; HTTP status is NOT an exit signal — ok:true is. */
async function callApi(conn, method, pathname, body) {
  const url = `http://127.0.0.1:${conn.port}${pathname}`;
  let res;
  try {
    res = await fetch(url, {
      method,
      headers: {
        Authorization: `Bearer ${conn.token}`,
        ...(body === undefined ? {} : { 'Content-Type': 'application/json' }),
      },
      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
    });
  } catch (err) {
    fail(
      `cannot reach the nightshift daemon at ${url} (${err.message}) — is the service running, and is NIGHTSHIFT_PORT right?`,
    );
  }
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    fail(`daemon returned non-JSON (HTTP ${res.status}): ${text.slice(0, 200)}`);
  }
}

/** Readable one-job block. */
function formatJob(job) {
  const lines = [
    `id:        ${job.id}`,
    `status:    ${job.status}`,
    `type:      ${job.type}`,
    `title:     ${job.title}`,
    `workdir:   ${job.workdir}`,
    `attempts:  ${job.attempts}`,
    `created:   ${job.createdAt}`,
  ];
  if (job.startedAt) lines.push(`started:   ${job.startedAt}`);
  if (job.endedAt) lines.push(`ended:     ${job.endedAt}`);
  if (job.pid !== null && job.pid !== undefined) lines.push(`pid:       ${job.pid}`);
  if (job.retryOf) lines.push(`retry of:  ${job.retryOf}`);
  lines.push(`log:       ${job.logPath}`);
  return lines.join('\n');
}

/** Readable jobs table. */
function formatJobList(jobsList) {
  if (jobsList.length === 0) return '(no jobs)';
  const rows = jobsList.map((j) => [j.id, j.status, j.type, String(j.attempts), j.title]);
  const header = ['ID', 'STATUS', 'TYPE', 'ATT', 'TITLE'];
  const widths = header.map((h, i) => Math.max(h.length, ...rows.map((r) => r[i].length)));
  const line = (cols) => cols.map((c, i) => c.padEnd(widths[i])).join('  ');
  return [line(header), ...rows.map(line)].join('\n');
}

/** Readable PromotionRecord block (steps as one line each). */
function formatPromotion(p) {
  const lines = [
    `slug:      ${p.slug}`,
    `title:     ${p.title}`,
    `status:    ${p.status}`,
    `source:    ${p.sourcePath}`,
    `url:       ${p.url ?? '—'}`,
    `repo:      ${p.repoUrl ?? '—'}`,
  ];
  if (p.error) lines.push(`error:     ${p.error}`);
  if (Array.isArray(p.steps) && p.steps.length > 0) {
    lines.push('steps:');
    for (const step of p.steps) {
      lines.push(`  ${step.ok ? 'ok  ' : 'FAIL'} ${step.name}: ${step.detail}`);
    }
  }
  return lines.join('\n');
}

/** Readable validator verdict (contracts/generative-ui.md verdict shape). */
function formatVerdict(v) {
  if (v.valid) return 'Valid.';
  const lines = ['INVALID:'];
  for (const violation of v.violations) lines.push(`  ${violation.rule}: ${violation.detail}`);
  return lines.join('\n');
}

/** Readable one-resource block (UiResourceRecord; html — when the door sent
 * it, i.e. `ui show <name> <version>` — is elided from the human render:
 * use --json to get the raw page). */
function formatUiResource(r) {
  return [
    `name:      ${r.name}`,
    `version:   ${r.version}`,
    `uri:       ui://nightshift/${r.name}@v${r.version}`,
    `active:    ${r.active ? 'yes' : 'no'}`,
    `requested: ${r.requestedTools.length > 0 ? r.requestedTools.join(', ') : '(none)'}`,
    `granted:   ${r.grantedTools.length > 0 ? r.grantedTools.join(', ') : '(none — zero-trust)'}`,
    `bytes:     ${r.htmlBytes}`,
    `created:   ${r.createdAt}`,
    ...(r.provenance ? [`provenance: ${r.provenance}`] : []),
  ].join('\n');
}

/** Readable one-grant block (UiGrantRecord, contracts/generative-ui.md). */
function formatUiGrant(g) {
  return [
    `name:      ${g.name}`,
    `tool:      ${g.tool}`,
    `granted:   ${g.grantedAt}`,
    `revoked:   ${g.revokedAt ?? '—'}`,
    `approval:  ${g.approvalText}`,
  ].join('\n');
}

/** Readable state block (contracts/ui-state.md get shape). Never-set is the
 * null/null pair; a deliberately-set null value still shows its updatedAt. */
function formatUiState(s) {
  return [
    `name:      ${s.name}`,
    `updated:   ${s.updatedAt ?? '— (never set)'}`,
    `value:     ${s.updatedAt === null ? '(none)' : JSON.stringify(s.value)}`,
  ].join('\n');
}

/** Readable ui resources table. */
function formatUiList(resources) {
  if (resources.length === 0) return '(no ui resources)';
  const rows = resources.map((r) => [
    r.name,
    `v${r.version}`,
    r.active ? 'yes' : 'no',
    r.requestedTools.join(',') || '-',
    String(r.htmlBytes),
  ]);
  const header = ['NAME', 'VER', 'ACTIVE', 'REQUESTED', 'BYTES'];
  const widths = header.map((h, i) => Math.max(h.length, ...rows.map((r) => r[i].length)));
  const line = (cols) => cols.map((c, i) => c.padEnd(widths[i])).join('  ');
  return [line(header), ...rows.map(line)].join('\n');
}

function formatStatus(s) {
  const j = s.jobs;
  return [
    `version:   ${s.version}`,
    `uptime:    ${s.uptimeSec}s`,
    `session:   ${s.session.id ?? '(none yet)'} (${s.session.turns} turns)`,
    `jobs:      queued ${j.queued}, running ${j.running}, succeeded ${j.succeeded}, failed ${j.failed}, killed ${j.killed}`,
    `rotation:  ${s.rotation.enabled ? 'enabled' : 'disabled'}`,
    `job runner: ${s.jobsEnabled ? 'enabled' : 'disabled'}`,
  ].join('\n');
}

/** Split argv into { command, positionals, options, json }; --help handled here. */
function parseArgs(argv) {
  const takesValue = new Set([
    '--type',
    '--title',
    '--instruction',
    '--workdir',
    '--status',
    '--params',
    '--note',
    '--slug',
    '--name',
    '--tools',
    '--provenance',
    '--approval',
    '--set',
  ]);
  const options = {};
  const positionals = [];
  let json = false;
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--json') json = true;
    else if (arg === '--dry-run') options.dryRun = true;
    else if (arg === '--yes') options.yes = true;
    else if (arg === '-h' || arg === '--help') {
      process.stdout.write(`${USAGE}\n`);
      process.exit(0);
    } else if (takesValue.has(arg)) {
      const value = argv[i + 1];
      if (value === undefined) fail(`${arg} requires a value\n\n${USAGE}`);
      options[arg.slice(2)] = value;
      i += 1;
    } else if (arg === '-') {
      // Stage 36: bare `-` is a positional (stdin marker for ui validate/
      // install), never an option.
      positionals.push(arg);
    } else if (arg.startsWith('-')) {
      fail(`unknown option: ${arg}\n\n${USAGE}`);
    } else {
      positionals.push(arg);
    }
  }
  const command = positionals.shift();
  return { command, positionals, options, json };
}

/** Run the parsed command; returns { result, render } (render = human formatter). */
async function runCommand(conn, parsed) {
  const { command, positionals, options } = parsed;
  switch (command) {
    case 'submit': {
      // Typed form (Stage 6): --type + --params '<json>' — the daemon's
      // registry renders instruction/workdir/permissions. Mutually exclusive
      // with the raw flags (the raw form is the generic worker, unchanged).
      if (options.params !== undefined) {
        if (options.type === undefined || options.type === '') {
          fail(`submit --params requires --type\n\n${USAGE}`);
        }
        for (const field of ['title', 'instruction', 'workdir']) {
          if (options[field] !== undefined) {
            fail(`submit --params cannot be combined with --${field} (put it in the params JSON)\n\n${USAGE}`);
          }
        }
        let params;
        try {
          params = JSON.parse(options.params);
        } catch (err) {
          fail(`--params is not valid JSON: ${err.message}`);
        }
        const result = await callApi(conn, 'POST', '/api/v1/jobs', {
          type: options.type,
          params,
        });
        return { result, render: (r) => `Job submitted.\n${formatJob(r.job)}` };
      }
      for (const field of ['type', 'title', 'instruction', 'workdir']) {
        if (options[field] === undefined || options[field] === '') {
          fail(`submit requires --${field}\n\n${USAGE}`);
        }
      }
      const result = await callApi(conn, 'POST', '/api/v1/jobs', {
        schema: 1,
        type: options.type,
        title: options.title,
        instruction: options.instruction,
        workdir: options.workdir,
        env: 'minimal',
      });
      return { result, render: (r) => `Job submitted.\n${formatJob(r.job)}` };
    }
    case 'jobs': {
      const query = options.status === undefined ? '' : `?status=${encodeURIComponent(options.status)}`;
      const result = await callApi(conn, 'GET', `/api/v1/jobs${query}`);
      return { result, render: (r) => formatJobList(r.jobs) };
    }
    case 'job': {
      const id = positionals[0];
      if (id === undefined) fail(`job requires an id\n\n${USAGE}`);
      const result = await callApi(conn, 'GET', `/api/v1/jobs/${encodeURIComponent(id)}`);
      return { result, render: (r) => formatJob(r.job) };
    }
    case 'kill': {
      const id = positionals[0];
      if (id === undefined) fail(`kill requires an id\n\n${USAGE}`);
      const result = await callApi(conn, 'POST', `/api/v1/jobs/${encodeURIComponent(id)}/kill`);
      return { result, render: (r) => `Job killed.\n${formatJob(r.job)}` };
    }
    case 'deliver': {
      const target = positionals[0];
      if (target === undefined) fail(`deliver requires a file path\n\n${USAGE}`);
      // Resolve relative paths against OUR cwd — the daemon only ever sees
      // (and confines) an absolute path.
      const path = await import('node:path');
      const body = { path: path.resolve(target) };
      if (options.note !== undefined) body.note = options.note;
      const result = await callApi(conn, 'POST', '/api/v1/deliver', body);
      return {
        result,
        render: (r) => `Delivered ${r.delivered.path} to room ${r.delivered.roomId}`,
      };
    }
    case 'promote': {
      // 1:1 face of POST /api/v1/promote (contracts/promotion.md +
      // site-promotion.md — the daemon routes by content shape). DRY RUN IS
      // THE DEFAULT: with neither --dry-run nor --yes, confirm stays false —
      // the plan is printed and nothing executes.
      const target = positionals[0];
      if (target === undefined) fail(`promote requires a path\n\n${USAGE}`);
      if (options.dryRun === true && options.yes === true) {
        fail(`--dry-run and --yes are mutually exclusive\n\n${USAGE}`);
      }
      // Resolve relative paths against OUR cwd — the daemon only ever sees
      // (and confines) an absolute path.
      const path = await import('node:path');
      const body = { path: path.resolve(target), confirm: options.yes === true };
      if (options.slug !== undefined) body.slug = options.slug;
      if (options.title !== undefined) body.title = options.title;
      const result = await callApi(conn, 'POST', '/api/v1/promote', body);
      return {
        result,
        render: (r) =>
          formatPromotion(r.promotion) +
          (body.confirm
            ? '\n\nExecution started in the background — the result arrives as a 🚀 notice in Webex.'
            : '\n\nDry run only — NOTHING was executed. Re-run with --yes to execute this plan.'),
      };
    }
    case 'remarkable': {
      // 1:1 face of POST /api/v1/remarkable (Stage 19): push a document to the
      // owner's reMarkable tablet /Inbox via the reMarkable cloud.
      const target = positionals[0];
      if (target === undefined) fail(`remarkable requires a file path\n\n${USAGE}`);
      // Resolve relative paths against OUR cwd — the daemon only ever sees
      // (and confines) an absolute path.
      const path = await import('node:path');
      const body = { path: path.resolve(target) };
      const result = await callApi(conn, 'POST', '/api/v1/remarkable', body);
      return {
        result,
        render: (r) => `Pushed ${r.pushed.path} to reMarkable ${r.pushed.folder}`,
      };
    }
    case 'ui': {
      // 1:1 face of the /api/v1/ui/* doors (Stages 31–33, contracts/generative-ui.md).
      // Files (or stdin, via `-` — Stage 36) are read HERE and shipped as HTML
      // in the body — the daemon never reads author files from disk.
      const sub = positionals[0];
      const readHtml = async (target) => {
        if (target === undefined) {
          fail(`ui ${sub} requires a file path (or - for stdin)\n\n${USAGE}`);
        }
        if (target === '-') {
          // Stage 36: `-` ALWAYS means stdin (a file literally named "-" is
          // not addressable this way — use a path). Read to EOF; works for
          // pipes and heredocs alike. An empty body is an authoring mistake —
          // fail HERE, nothing is sent to the daemon.
          const chunks = [];
          for await (const chunk of process.stdin) chunks.push(chunk);
          const html = Buffer.concat(chunks).toString('utf8');
          if (html.trim() === '') {
            fail(`ui ${sub} -: stdin was empty — pipe or heredoc the HTML into the command\n\n${USAGE}`);
          }
          return html;
        }
        const fs = await import('node:fs');
        const path = await import('node:path');
        try {
          return fs.readFileSync(path.resolve(target), 'utf8');
        } catch (err) {
          fail(`cannot read ${target}: ${err.message}`);
        }
      };
      if (sub === 'validate') {
        const html = await readHtml(positionals[1]);
        const result = await callApi(conn, 'POST', '/api/v1/ui/validate', { html });
        return { result, render: (r) => formatVerdict(r.verdict) };
      }
      if (sub === 'install') {
        if (options.name === undefined || options.name === '') {
          fail(`ui install requires --name\n\n${USAGE}`);
        }
        const html = await readHtml(positionals[1]);
        const body = { name: options.name, html };
        if (options.tools !== undefined) {
          body.requestedTools = options.tools
            .split(',')
            .map((t) => t.trim())
            .filter((t) => t !== '');
        }
        if (options.provenance !== undefined) body.provenance = options.provenance;
        const result = await callApi(conn, 'POST', '/api/v1/ui/resources', body);
        return { result, render: (r) => `Installed.\n${formatUiResource(r.resource)}` };
      }
      if (sub === 'list') {
        const result = await callApi(conn, 'GET', '/api/v1/ui/resources');
        return { result, render: (r) => formatUiList(r.resources) };
      }
      if (sub === 'show') {
        // Stage 32: without a version — every version of the name (active
        // marked); with one — that version's record (html rides only on
        // --json, keeping the human render scannable).
        const name = positionals[1];
        if (name === undefined) fail(`ui show requires a name\n\n${USAGE}`);
        const version = positionals[2];
        if (version === undefined) {
          const result = await callApi(
            conn,
            'GET',
            `/api/v1/ui/resources/${encodeURIComponent(name)}`,
          );
          return {
            result,
            render: (r) => `${r.name} (active: v${r.active})\n${formatUiList(r.versions)}`,
          };
        }
        if (!/^[1-9][0-9]*$/.test(version)) {
          fail(`ui show version must be a positive integer, got: ${version}\n\n${USAGE}`);
        }
        const result = await callApi(
          conn,
          'GET',
          `/api/v1/ui/resources/${encodeURIComponent(name)}/${version}`,
        );
        return { result, render: (r) => formatUiResource(r.resource) };
      }
      if (sub === 'activate') {
        // Stage 32: rollback = re-activation of a retained version.
        const name = positionals[1];
        const version = positionals[2];
        if (name === undefined || version === undefined) {
          fail(`ui activate requires a name and a version\n\n${USAGE}`);
        }
        if (!/^[1-9][0-9]*$/.test(version)) {
          fail(`ui activate version must be a positive integer, got: ${version}\n\n${USAGE}`);
        }
        const result = await callApi(
          conn,
          'POST',
          `/api/v1/ui/resources/${encodeURIComponent(name)}/activate`,
          { version: Number.parseInt(version, 10) },
        );
        return { result, render: (r) => `Activated.\n${formatUiResource(r.resource)}` };
      }
      if (sub === 'grant') {
        // Stage 33: durable owner approval — --approval carries the owner's
        // in-chat approval message into the ui_grants history.
        const [, name, tool] = positionals;
        if (name === undefined || tool === undefined) {
          fail(`ui grant requires <name> and <tool>\n\n${USAGE}`);
        }
        if (options.approval === undefined || options.approval === '') {
          fail(`ui grant requires --approval <text> (the owner's approval message)\n\n${USAGE}`);
        }
        const result = await callApi(conn, 'POST', '/api/v1/ui/grants', {
          name,
          tool,
          approvalText: options.approval,
        });
        return { result, render: (r) => `Granted.\n${formatUiGrant(r.grant)}` };
      }
      if (sub === 'revoke') {
        const [, name, tool] = positionals;
        if (name === undefined || tool === undefined) {
          fail(`ui revoke requires <name> and <tool>\n\n${USAGE}`);
        }
        const result = await callApi(conn, 'POST', '/api/v1/ui/grants/revoke', { name, tool });
        return { result, render: (r) => `Revoked.\n${formatUiGrant(r.grant)}` };
      }
      if (sub === 'state') {
        // Stage 37 (contracts/ui-state.md): the per-name state document.
        // Without --set: GET (read). With --set '<json>': POST (full replace)
        // — the JSON is parsed HERE so a typo fails locally, like --params.
        const name = positionals[1];
        if (name === undefined) fail(`ui state requires a name\n\n${USAGE}`);
        if (options.set !== undefined) {
          let value;
          try {
            value = JSON.parse(options.set);
          } catch (err) {
            fail(`--set is not valid JSON: ${err.message}`);
          }
          const result = await callApi(
            conn,
            'POST',
            `/api/v1/ui/state/${encodeURIComponent(name)}`,
            { value },
          );
          return {
            result,
            render: (r) => `State set.\nname:      ${r.name}\nupdated:   ${r.updatedAt}`,
          };
        }
        const result = await callApi(conn, 'GET', `/api/v1/ui/state/${encodeURIComponent(name)}`);
        return { result, render: formatUiState };
      }
      fail(`unknown ui subcommand: ${sub ?? '(none)'}\n\n${USAGE}`);
      break;
    }
    case 'rotate': {
      const result = await callApi(conn, 'POST', '/api/v1/session/rotate', { reason: 'manual' });
      return {
        result,
        render: (r) =>
          `Rotated: ${r.rotation.closedSessionId} -> ${r.rotation.newSessionId} (${r.rotation.reason})\nSummary: ${r.rotation.summaryPath}`,
      };
    }
    case 'status': {
      const result = await callApi(conn, 'GET', '/api/v1/status');
      return { result, render: formatStatus };
    }
    case undefined:
      fail(`missing command\n\n${USAGE}`);
      break;
    default:
      fail(`unknown command: ${command}\n\n${USAGE}`);
  }
  return { result: { ok: false, error: 'unreachable' }, render: () => '' };
}

async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (parsed.command === undefined && !parsed.json) fail(`missing command\n\n${USAGE}`);
  const conn = await resolveConnection();
  const { result, render } = await runCommand(conn, parsed);

  if (parsed.json) {
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  } else if (result.ok === true) {
    process.stdout.write(`${render(result)}\n`);
  } else {
    process.stderr.write(`error: ${result.error ?? 'unknown error'}\n`);
  }
  process.exit(result.ok === true ? 0 : 1);
}

main().catch((err) => {
  fail(err && err.message ? err.message : String(err));
});
